kshop"}]},"requiredField":true},{"fieldLabel":"InstaPay reference number","fieldName":"payment_ref","requiredField":true},{"fieldLabel":"Payment screenshot","fieldType":"file","fieldName":"screenshot","multipleFiles":false,"acceptFileTypes":".jpg,.jpeg,.png","requiredField":true}]},"responseMode":"lastNode","options":{}},"id":"n375","name":"Registration Form","type":"n8n-nodes-base.formTrigger","typeVersion":2.5,"position":[0,0]},{"parameters":{"jsCode":"const j = $json; const g = (k, l) => String(j[k] ?? j[l] ?? '').trim(); const file = Object.values($input.first().binary || {})[0];\nconst a = { name: g('name', 'Full name'), email: g('email', 'Email').toLowerCase(), phone: g('phone', 'Mobile').replace(/[^0-9+]/g, '').replace(/^(\\+20|0020|20)(?=1)/, '0'),\n  event_id: (g('event', 'Event').match(/E-\\d{2}/) || [''])[0], payment_ref: g('payment_ref', 'InstaPay reference number').replace(/\\s/g, '') };\nconst p = [];\nif (a.name.split(/\\s+/).length < 2) p.push('write your full name as it should appear on the certificate');\nif (!/^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/.test(a.email)) p.push('email looks invalid');\nif (!/^01[0125]\\d{8}$/.test(a.phone)) p.push('mobile must be an Egyptian number');\nif (!/^[A-Za-z0-9]{6,20}$/.test(a.payment_ref)) p.push('InstaPay reference should be 6–20 letters or digits');\nif (!file || !/image\\//.test(file.mimeType || '')) p.push('upload the payment screenshot as an image');\nconst b64 = file && !p.length ? (await this.helpers.getBinaryDataBuffer(0, Object.keys($input.first().binary)[0])).toString('base64') : '';\nreturn [{ json: { ...a, b64, mime: file?.mimeType || '', problems: p, ok: !p.length } }];"},"id":"n376","name":"Validate Registration","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,0]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":3},"conditions":[{"id":"c377","leftValue":"={{ $json.ok }}","rightValue":"","operator":{"type":"boolean","operation":"tr