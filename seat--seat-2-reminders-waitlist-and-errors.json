    {
      "parameters": {
        "jsCode": "// Reminders 1 day and 1 hour before, and promotion from the waitlist when a confirmed seat was cancelled.\nconst now = $now.setZone('Africa/Cairo'); const P = s => DateTime.fromFormat(String(s || ''), 'yyyy-MM-dd HH:mm', { zone: 'Africa/Cairo' });\nconst events = Object.fromEntries($('Read Events').all().map(i => [i.json.event_id, i.json]));\nconst regs = $input.all().map(i => i.json).filter(r => r.reg_id);\nconst out = [];\nfor (const r of regs.filter(r => r.status === 'confirmed')) {\n  const e = events[r.event_id]; if (!e) continue; const h = P(e.starts_at).diff(now, 'hours').hours;\n  if (h > 0 && h <= 24 && !r.reminder_1d) out.push({ json: { action: 'remind_1d', r, e } });\n  else if (h > 0 && h <= 1.25 && !r.reminder_1h) out.push({ json: { action: 'remind_1h', r, e } });\n}\nfor (const e of Object.values(events)) {\n  if (e.status !== 'open' || P(e.starts_at) < now) continue;\n  const free = Number(e.capacity) - regs.filter(r => r.event_id === e.event_id && r.status === 'confirmed').length;\n  regs.filter(r => r.event_id === e.event_id && r.status === 'waitlist').sort((a, b) => Number(a.waitlist_position) - Number(b.waitlist_position))\n    .slice(0, Math.max(0, free)).forEach(r => out.push({ json: { action: 'promote', r, e } }));\n}\nreturn out;"
      },
