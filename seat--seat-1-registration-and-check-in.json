      "parameters": {
        "jsCode": "// Valid only if confirmed, not used before, and the event is today.\nconst r = $input.first().json; const t = $('Read Token').first().json;\nlet msg, ok = false;\nif (!t.token) msg = '❌ No ticket code found in that message.';\nelse if (!r.reg_id) msg = '❌ Unknown ticket.';\nelse if (r.status !== 'confirmed') msg = '❌ Ticket status is ' + r.status + '.';\nelse if (r.checked_in_at) msg = '⚠️ Already checked in at ' + r.checked_in_at + ' (' + r.name + ').';\nelse { ok = true; msg = '✅ Welcome ' + r.name + ' (' + r.reg_id + ')'; }\nreturn [{ json: { ok, msg, reg_id: r.reg_id, chat_id: t.chat_id } }];"
      },
