    {
      "parameters": {
        "jsCode": "// The screenshot must prove: successful transfer, the exact ticket price, to our handle, recent, with the reference the person typed.\nconst a = $('Check Event Rules').first().json; const e = a.event;\nlet s; try { s = JSON.parse(($json.candidates?.[0]?.content?.parts || []).map(p => p.text).join('')); } catch (x) { s = null; }\nconst p = [];\nif (!s || !s.is_payment_receipt) p.push('screenshot is not a payment receipt');\nelse {\n  if (s.status !== 'successful') p.push('transfer status is ' + s.status);\n  if (Math.abs(Number(s.amount) - Number(e.price_egp)) > 0.5) p.push('amount ' + s.amount + ' ≠ ticket price ' + e.price_egp);\n  if (s.recipient && !String(s.recipient).toLowerCase().includes(String(e.instapay_handle).split('@')[0].toLowerCase())) p.push('sent to ' + s.recipient + ', not ' + e.instapay_handle);\n  if (s.reference && String(s.reference).replace(/\\s/g, '').toUpperCase() !== a.payment_ref.toUpperCase()) p.push('reference on the screenshot (' + s.reference + ') differs from the one typed');\n  const d = DateTime.fromISO(String(s.date || ''), { zone: 'Africa/Cairo' }); if (!d.isValid || $now.diff(d, 'days').days > 3) p.push('payment date missing or older than 3 days');\n}\nconst token = 'SEAT-' + Array.from({ length: 4 }, () => Math.random().toString(36).slice(2, 6).toUpperCase()).join('');\nreturn [{ json: { ...a, b64: undefined, prompt: undefined, paid_amount: s?.amount || '', payment_problems: p, payment_ok: !p.length, qr_token: token,\n  reg_id: 'G-' + $now.setZone('Africa/Cairo').toFormat('yyMMdd') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase(),\n  status: p.length ? 'payment_review' : a.full ? 'waitlist' : 'confirmed' } }];"
      },
