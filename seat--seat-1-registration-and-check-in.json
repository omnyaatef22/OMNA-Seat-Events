    {
      "parameters": {
        "jsCode": "// One seat per person, event must be open and in the future, reference numbers can be used once.\nconst a = $('Validate Registration').first().json; const e = $('Read Event').first().json;\nconst regs = $input.all().map(i => i.json).filter(r => r.reg_id && r.status !== 'cancelled');\nconst p = [];\nif (!e.event_id || e.status !== 'open') p.push('registration for this event is closed');\nif (DateTime.fromFormat(String(e.starts_at), 'yyyy-MM-dd HH:mm', { zone: 'Africa/Cairo' }) < $now) p.push('this event already started');\nif (regs.some(r => r.email === a.email || r.phone === a.phone)) p.push('you are already registered (same email or mobile)');\nif (regs.some(r => String(r.payment_ref).toUpperCase() === a.payment_ref.toUpperCase())) p.push('this InstaPay reference was already used');\nconst confirmed = regs.filter(r => r.status === 'confirmed').length;\nconst waitlist = regs.filter(r => r.status === 'waitlist').length;\nreturn [{ json: { ...a, event: e, problems: p, ok: !p.length, full: confirmed >= Number(e.capacity), waitlist_position: waitlist + 1, b64: a.b64,\n  mime: a.mime,\n  prompt: 'This is a screenshot of an Egyptian InstaPay or bank transfer. Return JSON only: {\"is_payment_receipt\": true|false, \"amount\": number, \"currency\": \"EGP\", \"reference\": \"\", \"recipient\": \"\", \"date\": \"YYYY-MM-DD\", \"status\": \"successful|failed|pending|unknown\"}. Use \"\" or 0 when not visible.' } }];"
      },
